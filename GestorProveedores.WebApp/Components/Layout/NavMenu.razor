@inject WebAppSessionService SessionService

<div class="brand-block">
    <div class="brand-mark">GP</div>
    <div>
        <a class="navbar-brand" href="">Gestor Proveedores</a>
        <span class="brand-caption">Control integral</span>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column" aria-label="Navegacion principal">
        <div class="nav-section">Trabajo</div>
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="nav-icon">IN</span> Inicio
            </NavLink>
        </div>

        <div class="nav-item">
            <a class="nav-link" href="#operacion">
                <span class="nav-icon">SO</span> Solicitudes
            </a>
        </div>

        <div class="nav-item">
            <a class="nav-link" href="#flujo">
                <span class="nav-icon">FL</span> Flujo
            </a>
        </div>

        <div class="nav-section">Sesion</div>
        <div class="nav-session">
            @if (session is not null)
            {
                <span>@session.Usuario.Rol</span>
                <strong>@session.Usuario.Nombre</strong>
                <form method="post" action="/account/logout">
                    <button type="submit">Cerrar sesion</button>
                </form>
            }
        </div>
    </nav>
</div>

@code {
    private LoginResponse? session;

    protected override void OnInitialized() => session = SessionService.GetCurrentSession();
}

